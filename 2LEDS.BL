
#include "BluetoothSerial.h"

BluetoothSerial SerialBT;

// Pines de los LEDs
const int LED1 = 18;
const int LED2 = 19;

void setup() {
  Serial.begin(115200);

  pinMode(LED1, OUTPUT);
  pinMode(LED2, OUTPUT);

  digitalWrite(LED1, LOW);
  digitalWrite(LED2, LOW);

  // Nombre Bluetooth
  SerialBT.begin("Berenisse Arce");

  Serial.println("Bluetooth conectado");
}

void loop() {

  if (SerialBT.available()) {

    char dato = SerialBT.read();

    if (dato == '1') {
      digitalWrite(LED1, HIGH);
    }

    if (dato == '2') {
      digitalWrite(LED1, LOW);
    }

    if (dato == '3') {
      digitalWrite(LED2, HIGH);
    }

    if (dato == '4') {
      digitalWrite(LED2, LOW);
    }

    if (dato == '5') {
      digitalWrite(LED1, HIGH);
      digitalWrite(LED2, HIGH);
    }

    if (dato == '0') {
      digitalWrite(LED1, LOW);
      digitalWrite(LED2, LOW);
    }
  }
}


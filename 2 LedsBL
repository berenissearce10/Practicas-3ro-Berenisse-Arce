
#include "BluetoothSerial.h"

BluetoothSerial SerialBT;

// Pines de los LEDs
const int LED1 = 18;
const int LED2 = 19;

void setup() {
  Serial.begin(115200);

  // Configurar los LEDs
  pinMode(LED1, OUTPUT);
  pinMode(LED2, OUTPUT);

  // Apagar los LEDs al iniciar
  digitalWrite(LED1, LOW);
  digitalWrite(LED2, LOW);

  // Nombre Bluetooth del ESP32
  SerialBT.begin("Berenisse Arce");

  Serial.println("Bluetooth listo");
}

void loop() {

  if (SerialBT.available()) {

    char dato = SerialBT.read();

    // LED 1
    if (dato == '1') {
      digitalWrite(LED1, HIGH);
    }

    if (dato == '2') {
      digitalWrite(LED1, LOW);
    }

    // LED 2
    if (dato == '3') {
      digitalWrite(LED2, HIGH);
    }

    if (dato == '4') {
      digitalWrite(LED2, LOW);
    }

    // Encender ambos LEDs
    if (dato == '5') {
      digitalWrite(LED1, HIGH);
      digitalWrite(LED2, HIGH);
    }

    // Apagar ambos LEDs
    if (dato == '0') {
      digitalWrite(LED1, LOW);
      digitalWrite(LED2, LOW);
    }
  }
}
